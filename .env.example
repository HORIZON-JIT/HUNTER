# === 共通設定 ===
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# === X テーマジェネレーター設定 ===
# Claude モデル（デフォルト: claude-sonnet-4-6）
# CLAUDE_MODEL=claude-sonnet-4-6

# 通知方法: discord または gmail
NOTIFICATION_METHOD=discord

# Discord Webhook URL（サーバー設定→連携サービス→ウェブフックで取得）
DISCORD_WEBHOOK_URL=

# Gmail設定（Gmailアプリパスワードが必要）
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_TO=

# 記事の最大取得期間（時間）デフォルト48時間
# ARTICLES_MAX_AGE_HOURS=48
