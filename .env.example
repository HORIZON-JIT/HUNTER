# === 共通設定 ===
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# === X テーマジェネレーター設定 ===
# Claude モデル（デフォルト: claude-sonnet-4-6）
# CLAUDE_MODEL=claude-sonnet-4-6

# 通知方法: line または gmail
NOTIFICATION_METHOD=line

# LINE Notify トークン（https://notify-bot.line.me/ で取得）
LINE_NOTIFY_TOKEN=

# Gmail設定（Gmailアプリパスワードが必要）
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_TO=

# 記事の最大取得期間（時間）デフォルト48時間
# ARTICLES_MAX_AGE_HOURS=48
